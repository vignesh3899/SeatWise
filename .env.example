# -----------------------------------------------------------------------------
# SeatWise Flutter environment variables
# Copy this file to `.env` (which is git-ignored) and fill in real values.
# The .env file is bundled as a Flutter asset and read via flutter_dotenv.
# NEVER commit real keys.
# -----------------------------------------------------------------------------

# OpenRouteService API key -> https://openrouteservice.org/dev/#/signup (free)
OPEN_ROUTE_API_KEY=

# OpenWeather API key -> https://home.openweathermap.org/users/sign_up (free)
OPEN_WEATHER_API_KEY=

# Firebase project identifiers (from your Firebase console / firebase_options)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# When true, the app calls the deployed Cloud Function for recommendations.
# When false (or when the function is unreachable), it uses the on-device engine.
USE_CLOUD_ENGINE=false
